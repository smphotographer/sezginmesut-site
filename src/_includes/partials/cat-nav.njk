{% set currentFeed = collections.akis %}{% if lang == "en" %}{% set currentFeed = collections.feedEn %}{% endif %}
      <nav aria-label="{{ ui.categories }}">
        <ul class="cat-nav">
          <li><a href="{{ blogPath }}"{% if not aktifKategori %} aria-current="page"{% endif %}>{{ ui.all }} <small>{{ currentFeed | length }}</small></a></li>
          {%- for kat in kategoriler.liste %}
          {%- set adet = currentFeed | whereCategory(kat.slug) | length %}
          {%- if adet > 0 %}
          <li><a href="{{ categoryPath }}{{ kat.slug }}/"{% if aktifKategori == kat.slug %} aria-current="page"{% endif %}>{{ kat.ad }} <small>{{ adet }}</small></a></li>
          {%- endif %}
          {%- endfor %}
        </ul>
      </nav>
