{%- set _title = seoTitle or title or site.title -%}
{%- if not isHome -%}{%- set _title = _title + " — " + site.name -%}{%- endif -%}
{%- set _desc = description or site.description -%}
{%- set _url = page.url | absUrl(site.url) -%}
{%- set _img = (cover or site.defaultImage) | absUrl(site.url) -%}
  <title>{{ _title | escape }}</title>
  <meta name="description" content="{{ _desc | escape }}">
  <meta name="author" content="{{ site.name }}">
  <meta name="robots" content="{{ 'noindex, follow' if noindex else 'index, follow, max-image-preview:large' }}">
  <link rel="canonical" href="{{ _url }}">

  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:title" content="{{ (seoTitle or title or site.title) | escape }}">
  <meta property="og:description" content="{{ _desc | escape }}">
  <meta property="og:url" content="{{ _url }}">
  <meta property="og:image" content="{{ _img }}">
  {%- if coverAlt %}
  <meta property="og:image:alt" content="{{ coverAlt }}">
  {%- endif %}
  {%- if ogType == "article" %}
  <meta property="article:published_time" content="{{ page.date | isoDate }}">
  <meta property="article:modified_time" content="{{ (updated or page.date) | isoDate }}">
  <meta property="article:author" content="{{ site.url }}/">
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ (seoTitle or title or site.title) | escape }}">
  <meta name="twitter:description" content="{{ _desc | escape }}">
  <meta name="twitter:image" content="{{ _img }}">
