  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "{{ site.url }}/#website",
        "url": "{{ site.url }}/",
        "name": "{{ site.name }}",
        "description": {{ site.description | dump | safe }},
        "inLanguage": "tr-TR",
        "publisher": { "@id": "{{ site.url }}/#person" }
      },
      {
        "@type": "Person",
        "@id": "{{ site.url }}/#person",
        "name": "{{ site.name }}",
        "url": "{{ site.url }}/",
        "image": "{{ site.defaultImage | absUrl(site.url) }}",
        "jobTitle": "Dijital İçerik Üreticisi ve Fotoğrafçı",
        "description": "Fotoğrafçılık, ahşap, bahçe, motosiklet ve gezi içerikleri üreten dijital içerik üreticisi.",
        "knowsAbout": ["Fotoğrafçılık", "Organik bahçecilik", "Ahşap işleri", "Motosiklet gezileri", "Ürün incelemeleri", "Grafik tasarım"],
        "sameAs": {{ site.sameAs | dump | safe }}
      }
    ]
  }
  </script>
