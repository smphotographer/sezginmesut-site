{
  "@type": "Person",
  "@id": "{{ site.url }}/#person",
  "name": "Sezgin Mesut",
  "url": "{{ site.url }}/hakkimda/",
  "image": "{{ site.defaultImage | absUrl(site.url) }}",
  "jobTitle": {{ ui.personJob | dump | safe }},
  "description": {{ ui.identity | dump | safe }},
