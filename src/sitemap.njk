---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}/</loc>
  </url>
  <url>
    <loc>{{ site.url }}/blog/</loc>
  </url>
  {%- for kat in kategoriler.liste %}
  {%- set katItems = collections.akis | whereCategory(kat.slug) %}
  {%- if katItems.length %}
  <url>
    <loc>{{ site.url }}/blog/kategori/{{ kat.slug }}/</loc>
  </url>
  {%- endif %}
  {%- endfor %}
  {%- for post in collections.yazilar %}
  <url>
    <loc>{{ post.url | absUrl(site.url) | escape }}</loc>
    <lastmod>{{ (post.data.updated or post.date) | isoDate }}</lastmod>
  </url>
  {%- endfor %}
  {%- for listing in collections.blogPages %}
  {%- if listing.url != '/blog/' %}
  <url><loc>{{ listing.url | absUrl(site.url) | escape }}</loc></url>
  {%- endif %}
  {%- endfor %}
</urlset>
