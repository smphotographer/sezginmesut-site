---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}
{%- if p.url and (p.url == '/' or p.url == '/en/' or p.url.startsWith('/blog/') or p.url.startsWith('/en/blog/')) and not p.url.endsWith('.xml') %}
{%- set include = true %}
{%- if p.data.kategori %}
{%- set feed = collections.akis %}{% if p.data.lang == 'en' %}{% set feed = collections.feedEn %}{% endif %}
{%- if (feed | whereCategory(p.data.kategori.slug) | length) == 0 %}{% set include = false %}{% endif %}
{%- endif %}
{%- if include %}<url><loc>{{ p.url | absUrl(site.url) | escape }}</loc>{% if p.data.ogType == 'article' %}<lastmod>{{ (p.data.updated or p.date) | isoDate }}</lastmod>{% endif %}</url>{% endif %}
{%- endif %}
{%- endfor %}
</urlset>
