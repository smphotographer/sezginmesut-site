{% block scripts %}
<script>
'use strict';
(() => {
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  document.getElementById('year').textContent = new Date().getFullYear();

  if ('IntersectionObserver' in window && !reduced.matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.06, rootMargin: '0px 0px 25px 0px' });
    document.querySelectorAll('.reveal').forEach((element) => observer.observe(element));
    document.body.classList.add('motion-ready');
  }

  if (finePointer.matches) {
    document.querySelectorAll('.channel-card, .instagram-card, .portfolio-card').forEach((card) => {
      let latest = null;
      let queued = false;
      card.addEventListener('pointermove', (event) => {
        if (reduced.matches) return;
        latest = { x: event.clientX, y: event.clientY };
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          if (!latest) return;
          const rect = card.getBoundingClientRect();
          const x = latest.x - rect.left;
          const y = latest.y - rect.top;
          card.style.setProperty('--mx', `${x}px`);
          card.style.setProperty('--my', `${y}px`);
          card.style.setProperty('--rx', `${(0.5 - y / rect.height) * 5}deg`);
          card.style.setProperty('--ry', `${(x / rect.width - 0.5) * 5}deg`);
        });
      });
      card.addEventListener('pointerleave', () => {
        latest = null;
        card.style.setProperty('--rx', '0deg');
        card.style.setProperty('--ry', '0deg');
      });
    });
  }

  const canvas = document.getElementById('ambient');
  const context = canvas.getContext('2d');
  if (!context) return;
  let width = 0;
  let height = 0;
  let particles = [];
  let frame = 0;
  let lastTime = 0;
  const resize = () => {
    width = document.documentElement.clientWidth;
    height = window.innerHeight;
    const ratio = Math.min(window.devicePixelRatio || 1, 1.5);
    canvas.width = width * ratio;
    canvas.height = height * ratio;
    context.setTransform(ratio, 0, 0, ratio, 0, 0);
    particles = Array.from({ length: width < 620 ? 15 : 32 }, () => ({
      x: Math.random() * width,
      y: Math.random() * height,
      radius: Math.random() * 1.1 + 0.4,
      speed: Math.random() * 0.22 + 0.08,
      opacity: Math.random() * 0.18 + 0.06,
      phase: Math.random() * Math.PI * 2
    }));
  };
  const draw = (time) => {
    if (document.hidden || reduced.matches) { frame = 0; return; }
    const step = Math.min((time - (lastTime || time)) / 16.67, 3);
    lastTime = time;
    context.clearRect(0, 0, width, height);
    particles.forEach((particle) => {
      particle.y -= particle.speed * step;
      if (particle.y < -3) particle.y = height + 3;
      const drift = Math.sin(time * 0.00015 + particle.phase) * 10;
      context.beginPath();
      context.arc(particle.x + drift, particle.y, particle.radius, 0, Math.PI * 2);
      context.fillStyle = `rgba(203,255,105,${particle.opacity})`;
      context.fill();
    });
    frame = requestAnimationFrame(draw);
  };
  const resume = () => {
    if (!document.hidden && !reduced.matches && !frame) {
      lastTime = 0;
      frame = requestAnimationFrame(draw);
    } else if (reduced.matches || document.hidden) {
      cancelAnimationFrame(frame);
      frame = 0;
      context.clearRect(0, 0, width, height);
    }
  };
  window.addEventListener('resize', resize, { passive: true });
  document.addEventListener('visibilitychange', resume);
  reduced.addEventListener('change', resume);
  resize();
  resume();
})();
</script>
